{
  "name": "botica-viva-landing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:styles && npm run build:headline && npm run build:rating && npm run build:vsl && npm run build:faq && npm run build:animations && node scripts/export-static.mjs",
    "build:animations": "tsx scripts/build-animations.tsx",
    "check:animations": "tsx scripts/check-animations.tsx",
    "build:faq": "tsx scripts/build-faq.tsx",
    "build:vsl": "tsx scripts/build-vsl.tsx",
    "build:styles": "tailwindcss -i styles/hook-question.css -o assets/nova-pagina/css/hook-question.css --minify && tailwindcss -i styles/rating-summary.css -o assets/nova-pagina/css/rating-summary.css --minify",
    "build:headline": "tsx scripts/build-hook-question.tsx",
    "typecheck": "tsc --noEmit",
    "check:hook": "tsx scripts/check-hook-question.tsx",
    "build:rating": "tsx scripts/build-rating-summary.tsx",
    "check:rating": "tsx scripts/check-rating-summary.tsx",
    "preview": "node servidor-local.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.3.1",
    "clsx": "2.1.1",
    "lucide-react": "1.58.0",
    "motion": "14.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.536",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
