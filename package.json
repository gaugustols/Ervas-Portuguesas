{
  "name": "botica-viva-landing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:styles && npm run build:headline",
    "build:styles": "tailwindcss -i styles/hook-question.css -o assets/nova-pagina/css/hook-question.css --minify",
    "build:headline": "tsx scripts/build-hook-question.tsx",
    "typecheck": "tsc --noEmit",
    "check:hook": "tsx scripts/check-hook-question.tsx",
    "preview": "node servidor-local.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.536",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
