{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] },
    "types": ["node"]
  },
  "include": ["components/**/*.tsx", "kit/**/*.ts", "lib/**/*.ts", "video/**/*.tsx", "video/**/*.ts", "scripts/**/*.tsx", "demo.tsx"]
}
